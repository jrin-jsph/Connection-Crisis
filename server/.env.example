# Connection Crisis Server Configuration

PORT=3001
HOST=0.0.0.0

# Optional Firebase Firestore Configuration
# If omitted or unconfigured, server seamlessly operates in In-Memory repository fallback mode.

# Option 1: Path to Firebase Admin Service Account JSON key file
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Option 2: Inline Service Account JSON string
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"connection-crisis",...}

# Option 3: Firebase Project ID
# FIREBASE_PROJECT_ID=connection-crisis
